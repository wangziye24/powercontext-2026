# MiniMax（开放平台申请；勿提交真实 Key）
MINIMAX_API_KEY=sk-cp-xxxxxxxxxxxxxxxx
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_EMBED_MODEL=embo-01          # 1536 维；请求体字段为 texts（非 OpenAI 的 input）
MINIMAX_CHAT_MODEL=MiniMax-M2.5

# embedding 提供方：minimax（云端，默认） | local（离线 fastembed bge-small-zh-v1.5，512 维）
EMBED_PROVIDER=minimax

# seekdb（MySQL 协议）
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
DB_NAME=coursenote

# 可选：PowerContext 记忆（记录课程偏好 / 检索历史，供后续复用）
ENABLE_MEMORY=false
POWCONTEXT_BASE_URL=http://127.0.0.1:8000
POWCONTEXT_API_KEY=
