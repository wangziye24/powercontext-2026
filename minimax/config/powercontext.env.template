# PowerContext Server 配置模板。
# scripts/start_server.sh 会把 __SDDCTX_HOME__ 与 __PORT__ 替换成实际值，
# 生成运行文件 $SDDCTX_HOME/powercontext.env（该文件不进入版本库）。
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=__PORT__
POWERCONTEXT_SERVER_MCP_ENABLED=true
POWERCONTEXT_SERVER_LOGGING_LEVEL=INFO
POWERCONTEXT_SERVER_LOGGING_FORMAT=console

# 任务状态保存在内嵌 seekdb 中，与上下文模块的工程资料索引使用同一个数据库产品。
POWERCONTEXT_SERVER_DATABASE_KIND=seekdb
POWERCONTEXT_SERVER_DATABASE_PATH=__SDDCTX_HOME__/powercontext/seekdb
