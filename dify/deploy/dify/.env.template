# ============================================================
# 《午夜便利店·阿夜的账本》—— Dify 1.18.0 本地部署配置
#
# 用法：
#   cd dify/deploy/dify
#   cp .env.template .env
#   # 按需修改 SECRET_KEY / INIT_PASSWORD
#   docker compose up -d
#
# 说明：
#   * COMPOSE_PROFILES=postgresql：只起 Postgres（默认向量库不需要，本作不用 Dify 知识库）
#   * 侧车服务与 PowerContext 跑在宿主机，Dify 容器通过 host.docker.internal 访问
#     （见 docker-compose.override.yaml 里的 extra_hosts）
# ============================================================

# ---------- 访问地址 ----------
CONSOLE_API_URL=http://localhost:5001
CONSOLE_WEB_URL=http://localhost:3000
SERVICE_API_URL=http://localhost:5001
APP_API_URL=http://localhost:5001
APP_WEB_URL=http://localhost:3000
FILES_URL=http://localhost:5001

# ---------- 安全（本地开发默认值，正式部署请改掉）----------
SECRET_KEY=dify-local-dev-secret-key-please-change-me
INIT_PASSWORD=nightstore
CONSOLE_CORS_ALLOW_ORIGINS=*
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
REMOTE_INSTALLING_ENABLED=false

# ---------- 数据库（Postgres：Dify 自身的工作流/应用数据）----------
DB_TYPE=postgresql
DB_USERNAME=postgres
DB_PASSWORD=difyai123456
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE=dify
DB_POOL_SIZE=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_EXTRA_PARAMS=

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=difyai123456
REDIS_USE_SSL=false
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100
REDIS_RETRY_RETRIES=3
REDIS_RETRY_BACKOFF_BASE=1.0
REDIS_RETRY_BACKOFF_CAP=10.0
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_KEY_PREFIX=

# ---------- 存储 ----------
STORAGE_TYPE=opendal
OPENDAL_SCHEME=fs
OPENDAL_FS_ROOT=storage

# ---------- 向量库（本作不使用 Dify 知识库，保持默认即可）----------
VECTOR_STORE=weaviate
VECTOR_INDEX_NAME_PREFIX=Vector_index

# ---------- 代码沙箱（状态机节点用 python3）----------
CODE_EXECUTION_ENDPOINT=http://sandbox:8194
CODE_EXECUTION_API_KEY=dify-sandbox
SANDBOX_API_KEY=dify-sandbox
SANDBOX_ENABLE_NETWORK=true
SANDBOX_GIN_MODE=release

# ---------- 插件 ----------
PLUGIN_DAEMON_KEY=lYkiYYT6owG+71oLerGzA7GXCgOT++6ovaezWAjpCjf+Sjc3ZtU+qUEi
PLUGIN_DIFY_INNER_API_KEY=QaHbTe77CtuXmsfyhR7+vRjI/+XbV1AaFy691iy+kGDv2Jvy0/eAh8Y1
PLUGIN_DIFY_INNER_API_URL=http://api:5001
PLUGIN_MAX_PACKAGE_SIZE=52428800
PLUGIN_MAX_FILE_SIZE=52428800
PLUGIN_STDIO_BUFFER_SIZE=1024
PLUGIN_STDIO_MAX_BUFFER_SIZE=5242880
PLUGIN_PYTHON_ENV_INIT_TIMEOUT=120
PLUGIN_MAX_EXECUTION_TIMEOUT=600

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_OUTPUT_FORMAT=text
LOG_FILE=/app/logs/server.log
LOG_FILE_MAX_SIZE=20
LOG_FILE_BACKUP_COUNT=5
LOG_DATEFORMAT=%Y-%m-%d %H:%M:%S
LOG_TZ=Asia/Shanghai

# ---------- 其他 ----------
MIGRATION_ENABLED=true
COMPOSE_PROFILES=postgresql
MARKETPLACE_API_BASE_URL=https://marketplace.dify.ai
INSTALL_METHOD=remote

# ---------- 插件守护进程（api/worker 通过它访问插件）----------
PLUGIN_DAEMON_URL=http://plugin_daemon:5002
PLUGIN_DAEMON_PORT=5002
EXPOSE_PLUGIN_DAEMON_PORT=5002
EXPOSE_PLUGIN_DEBUGGING_HOST=localhost
EXPOSE_PLUGIN_DEBUGGING_PORT=5003
DB_PLUGIN_DATABASE=dify_plugin

# ---------- 其它 ----------
EXPOSE_NGINX_PORT=80
MARKETPLACE_API_URL=https://marketplace.dify.ai
TEXT_GENERATION_TIMEOUT_MS=120000
WORKFLOW_GENERATION_TIMEOUT_MS=300000
