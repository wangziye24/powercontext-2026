# ============================================================
# 侧车服务配置示例（复制为 .env 后按需修改；不要提交真实密钥）
# ============================================================

# ---- seekdb（MySQL 协议）----
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
DB_NAME=nightstore

# ---- embedding ----
# local   = 离线确定性哈希向量（无 Key 也能跑，语义质量一般）
# minimax = MiniMax embo-01（1536 维，语义质量更好，需要 Key）
# 换 provider 后必须重跑 `python3 -m app.seed` 或 POST /admin/reindex
EMBED_PROVIDER=minimax
EMBED_DIM=1536
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_API_KEY=sk-xxxxxxxxxxxxxxxx
MINIMAX_EMBED_MODEL=embo-01

# ---- 检索 ----
TOP_K=5
RRF_CONSTANT=60

# ---- PowerContext（仅健康检查用）----
POWERCONTEXT_BASE_URL=http://127.0.0.1:8848
POWERCONTEXT_API_KEY=

# ---- 服务监听 ----
SIDECAR_HOST=0.0.0.0
SIDECAR_PORT=8090
